// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  SALES_EXECUTIVE
}

enum OrgPlan {
  FB_ONLY
  FB_WHATSAPP
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELLED
}

// A paying SaaS tenant on the shared multi-tenant deployment. Nullable on
// User because self-hosted single-tenant deployments (see OrgSettings below)
// never populate this — only accounts created via the public /signup flow do.
model Organization {
  id                   String             @id @default(cuid())
  name                 String
  plan                 OrgPlan
  subscriptionStatus   SubscriptionStatus @default(PENDING_PAYMENT)
  phonePeMerchantSubId String?            @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  users User[]

  @@map("organizations")
}

// Bridges the gap between initiating PhonePe checkout (browser-side) and the
// PhonePe webhook (server-to-server, no access to the browser's cookies).
// Created only at the payment step — earlier signup steps stay cookie-only,
// so an abandoned signup before payment never touches the database.
model PendingSignup {
  id                     String   @id @default(cuid())
  merchantOrderId        String   @unique
  merchantSubscriptionId String
  name                   String
  email                  String
  phone                  String?
  passwordHash           String
  avatarUrl              String?
  plan                   OrgPlan
  createdAt              DateTime @default(now())

  @@map("pending_signups")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole @default(SALES_EXECUTIVE)
  phone          String?
  avatarUrl      String?
  isActive       Boolean  @default(true)
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  refreshTokens             RefreshToken[]
  assignedLeads             Lead[]                 @relation("LeadAssignee")
  createdLeads              Lead[]                 @relation("LeadCreatedBy")
  notes                     Note[]
  activities                Activity[]
  followUps                 FollowUp[]             @relation("FollowUpCreatedBy")
  completedFollowUps        FollowUp[]             @relation("FollowUpCompletedBy")
  auditLogs                 AuditLog[]
  notifications             Notification[]
  connectedMetaAccounts     MetaAccount[]
  connectedWhatsAppAccounts WhatsAppAccount[]
  assignmentRuleMembers     AssignmentRuleMember[]
  sentWhatsAppMessages      WhatsAppMessage[]
  createdBookings           Booking[]              @relation("BookingCreatedBy")
  assignedBookings          Booking[]              @relation("BookingAssignee")
  cancelledBookings         Booking[]              @relation("BookingCancelledBy")

  @@index([role])
  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// Meta (Facebook/Instagram) connected accounts
// ─────────────────────────────────────────────────────────────

enum MetaAccountType {
  FACEBOOK_PAGE
  INSTAGRAM_ACCOUNT
}

model MetaAccount {
  id                  String          @id @default(cuid())
  type                MetaAccountType
  metaPageId          String          @unique
  name                String
  instagramBusinessId String?
  accessToken         String // encrypted at rest by app layer
  tokenExpiresAt      DateTime?
  isActive            Boolean         @default(true)
  connectedById       String?
  lastSyncedAt        DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  connectedBy User?      @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  campaigns   Campaign[]
  leadForms   LeadForm[]

  @@map("meta_accounts")
}

enum WhatsAppConnectionMethod {
  MANUAL_TOKEN
  EMBEDDED_SIGNUP
}

// A WhatsApp Business Platform (Cloud API) phone number — distinct from
// MetaAccount because click-to-WhatsApp leads have no Lead Ads form data;
// they only ever exist as inbound WhatsApp messages.
model WhatsAppAccount {
  id                 String                   @id @default(cuid())
  phoneNumberId      String                   @unique
  wabaId             String
  businessId         String?
  displayPhoneNumber String
  displayName        String?
  qualityRating      String?
  accessToken        String // encrypted at rest by app layer
  tokenExpiresAt     DateTime?
  connectedVia       WhatsAppConnectionMethod @default(MANUAL_TOKEN)
  isActive           Boolean                  @default(true)
  connectedById      String?
  lastMessageAt      DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  connectedBy User?             @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  messages    WhatsAppMessage[]

  @@index([wabaId])
  @@map("whatsapp_accounts")
}

// ─────────────────────────────────────────────────────────────
// WhatsApp message thread (per lead)
// ─────────────────────────────────────────────────────────────

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageStatus {
  RECEIVED
  SENT
  FAILED
}

model WhatsAppMessage {
  id                String                   @id @default(cuid())
  leadId            String
  whatsAppAccountId String
  direction         WhatsAppMessageDirection
  content           String
  messageType       String                   @default("text")
  status            WhatsAppMessageStatus    @default(RECEIVED)
  errorMessage      String?
  whatsAppMessageId String?                  @unique
  sentById          String?
  createdAt         DateTime                 @default(now())

  lead            Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  whatsAppAccount WhatsAppAccount @relation(fields: [whatsAppAccountId], references: [id])
  sentBy          User?           @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([whatsAppAccountId])
  @@map("whatsapp_messages")
}

// ─────────────────────────────────────────────────────────────
// Meta ad hierarchy (normalized, synced from Meta Graph API)
// ─────────────────────────────────────────────────────────────

model Campaign {
  id             String   @id @default(cuid())
  metaCampaignId String   @unique
  metaAccountId  String
  name           String
  objective      String?
  status         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  metaAccount MetaAccount @relation(fields: [metaAccountId], references: [id], onDelete: Cascade)
  adSets      AdSet[]
  leads       Lead[]

  @@index([metaAccountId])
  @@map("campaigns")
}

model AdSet {
  id          String   @id @default(cuid())
  metaAdSetId String   @unique
  campaignId  String
  name        String
  status      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      Ad[]
  leads    Lead[]

  @@index([campaignId])
  @@map("ad_sets")
}

model Ad {
  id        String   @id @default(cuid())
  metaAdId  String   @unique
  adSetId   String
  name      String
  status    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adSet AdSet  @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  leads Lead[]

  @@index([adSetId])
  @@map("ads")
}

model LeadForm {
  id            String   @id @default(cuid())
  metaFormId    String   @unique
  metaAccountId String
  name          String
  status        String?
  questions     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  metaAccount MetaAccount @relation(fields: [metaAccountId], references: [id], onDelete: Cascade)
  leads       Lead[]

  @@index([metaAccountId])
  @@map("lead_forms")
}

// ─────────────────────────────────────────────────────────────
// Lead status (configurable, not hardcoded)
// ─────────────────────────────────────────────────────────────

model LeadStatus {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6b7280")
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  isFinal   Boolean  @default(false) // e.g. Converted, Lost, Spam
  isWon     Boolean  @default(false) // e.g. Converted (for conversion-rate math)
  requiresFollowUp Boolean @default(false) // e.g. Follow-up, Call Back — shows a follow-up date picker when selected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads    Lead[]
  bookings Booking[]

  @@map("lead_statuses")
}

// ─────────────────────────────────────────────────────────────
// Leads
// ─────────────────────────────────────────────────────────────

enum LeadSource {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  MANUAL
  WEBSITE
  OTHER
}

model Lead {
  id String @id @default(cuid())

  // Core contact info
  fullName String
  phone    String
  email    String?
  city     String?
  state    String?

  // Meta attribution — normalized FKs (nullable: manual leads have none)
  campaignId String?
  adSetId    String?
  adId       String?
  formId     String?

  // Denormalized snapshot of attribution at capture time.
  // Meta campaign/ad names can be renamed or deleted later; the lead
  // must keep showing what it was attributed to when it came in.
  campaignName String?
  adName       String?
  adSetName    String?
  formName     String?

  // Which package this lead is interested in (from the gsb-holidays contact
  // form's package selector). packageInterest is a denormalized snapshot of
  // the package name at capture time — same rationale as campaignName above,
  // so it survives a package being renamed/deleted later.
  packageId       String?
  packageInterest String?

  source     LeadSource @default(MANUAL)
  metaLeadId String?    @unique // Meta's leadgen_id, used for dedup
  rawPayload Json? // full original payload from Meta webhook/API

  statusId      String
  assignedToId  String?
  createdById   String?
  followUpDate  DateTime?
  isDuplicate   Boolean   @default(false)
  duplicateOfId String?

  // Sequential invoice number issued when this lead is created via the
  // public website inquiry form (see InvoiceCounter) — null for leads
  // created by other sources (manual entry, Meta webhook, etc.).
  invoiceNumber String? @unique

  // Trip details captured on the website's contact form — null for leads
  // from other sources (Meta, manual entry, WhatsApp) that don't collect
  // this. These are what the visitor typed at inquiry time, not a
  // confirmed reservation — see Booking.checkInDate/checkOutDate for that.
  checkInDate   DateTime?
  checkOutDate  DateTime?
  guestsAdults  Int?
  guestsKids    Int?
  guestsInfants Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastActivityAt DateTime @default(now())

  campaign    Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  adSet       AdSet?     @relation(fields: [adSetId], references: [id], onDelete: SetNull)
  ad          Ad?        @relation(fields: [adId], references: [id], onDelete: SetNull)
  form        LeadForm?  @relation(fields: [formId], references: [id], onDelete: SetNull)
  package     Package?   @relation(fields: [packageId], references: [id], onDelete: SetNull)
  status      LeadStatus @relation(fields: [statusId], references: [id])
  assignedTo  User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   User?      @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  duplicateOf Lead?      @relation("LeadDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  Lead[]     @relation("LeadDuplicates")

  notes            Note[]
  activities       Activity[]
  followUps        FollowUp[]
  whatsAppMessages WhatsAppMessage[]
  bookings         Booking[]

  @@index([statusId])
  @@index([assignedToId])
  @@index([source])
  @@index([campaignId])
  @@index([packageId])
  @@index([createdAt])
  @@index([phone])
  @@map("leads")
}

// ─────────────────────────────────────────────────────────────
// Bookings — confirmed paying guests (optionally converted from a Lead)
// ─────────────────────────────────────────────────────────────

enum StayType {
  VILLA
  TENT_CAMPING
  COTTAGE
  FARM_HOUSE
  GLAMPING
  RESORT
}

enum BookingLocation {
  LONAVALA
  KARJAT
  ALIBAGH
  PANVEL
}

model Booking {
  id String @id @default(cuid())

  guestName String
  phone     String
  email     String?

  checkInDate  DateTime
  checkOutDate DateTime
  nights       Int      @default(1)

  stayType StayType?

  adultCount  Int @default(1)
  kidsCount   Int @default(0)
  infantCount Int @default(0)

  // "Per Person Amount" / "Per Kid Amount" in the UI — both are per-night
  // rates, multiplied by nights (as well as guest count) into totalRevenue.
  adultCostPerPerson Decimal @db.Decimal(12, 2)
  kidsCostPerPerson  Decimal @default(0) @db.Decimal(12, 2)
  vendorAmount       Decimal @default(0) @db.Decimal(12, 2)
  // "B2B" in the UI — same per-adult/per-kid/per-night shape as the main
  // pricing above (e.g. an agent/reseller's own per-guest nightly rate), not
  // a flat amount.
  b2bAdultAmount     Decimal @default(0) @db.Decimal(12, 2)
  b2bKidAmount       Decimal @default(0) @db.Decimal(12, 2)

  // Server-computed on every create/update via calculateBookingFinancials() —
  // never accepted directly from client input.
  totalRevenue  Decimal @db.Decimal(12, 2)
  profit        Decimal @db.Decimal(12, 2)
  advance       Decimal @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal @db.Decimal(12, 2)

  includesFood Boolean @default(false)
  notes        String?
  description  String?

  source   LeadSource?
  location BookingLocation?

  // Uses the same admin-configurable status list as leads (Settings > Lead
  // Statuses) rather than a fixed Confirmed/Cancelled enum — a booking's
  // status is just one more call-disposition-style value, not a separate
  // vocabulary. Revenue/earnings totals count every booking regardless of
  // status (see src/lib/queries/earnings.ts) since a Booking row already
  // represents a real reservation.
  statusId String
  status   LeadStatus @relation(fields: [statusId], references: [id])

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("BookingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Which package/destination this stay is for. packageName/destination are
  // a denormalized snapshot at booking time (same rationale as Lead's
  // campaignName snapshot) so earnings reporting survives a package being
  // renamed or deleted later.
  packageId   String?
  package     Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageName String?
  destination String?
  resortName  String?

  // Optional attachment (payment screenshot / ID proof) — stored on local
  // disk, not Vercel Blob, since this app is self-hosted via Docker.
  attachmentPath     String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?

  createdById String?
  createdBy   User?    @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Cancellation is a real terminal state distinct from `status` (which is
  // just the shared, admin-configurable LeadStatus list and has no fixed
  // "Cancelled" value) — set via a dedicated cancel endpoint, never through
  // the generic PATCH/statusId path.
  isCancelled   Boolean   @default(false)
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("BookingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  // Issued once via generateInvoiceNumber() (src/lib/invoice.ts) — the same
  // global sequence already used for website-lead invoices — the first time
  // a booking-event email is sent for this booking.
  invoiceNumber String? @unique

  @@index([leadId])
  @@index([packageId])
  @@index([assignedToId])
  @@index([checkInDate])
  @@index([statusId])
  @@index([createdAt])
  @@index([phone])
  @@index([isCancelled])
  @@map("bookings")
}

// ─────────────────────────────────────────────────────────────
// Activity timeline (full audit trail per lead)
// ─────────────────────────────────────────────────────────────

enum ActivityType {
  LEAD_CREATED
  ASSIGNED
  REASSIGNED
  STATUS_CHANGED
  CALLED
  NOTE_ADDED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_MISSED
  FOLLOW_UP_CANCELLED
  EMAIL_SENT
  WHATSAPP_SENT
  WHATSAPP_REPLIED
  CONVERTED
  MARKED_LOST
  MARKED_SPAM
  MARKED_DUPLICATE
}

model Activity {
  id          String       @id @default(cuid())
  leadId      String
  userId      String? // null = system-generated (e.g. webhook sync)
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([createdAt])
  @@map("activities")
}

// ─────────────────────────────────────────────────────────────
// Notes (with @mentions)
// ─────────────────────────────────────────────────────────────

model Note {
  id               String   @id @default(cuid())
  leadId           String
  userId           String
  content          String
  mentionedUserIds String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("notes")
}

// ─────────────────────────────────────────────────────────────
// Follow-ups
// ─────────────────────────────────────────────────────────────

enum FollowUpStatus {
  PENDING
  DONE
  MISSED
  CANCELLED
}

model FollowUp {
  id            String         @id @default(cuid())
  leadId        String
  dueAt         DateTime
  note          String?
  status        FollowUpStatus @default(PENDING)
  createdById   String
  completedById String?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  lead        Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy   User  @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  completedBy User? @relation("FollowUpCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([dueAt])
  @@index([status])
  @@map("follow_ups")
}

// ─────────────────────────────────────────────────────────────
// Assignment rules (round robin / bulk)
// ─────────────────────────────────────────────────────────────

enum AssignmentMethod {
  MANUAL
  ROUND_ROBIN
  BULK
}

model AssignmentRule {
  id                String           @id @default(cuid())
  name              String
  method            AssignmentMethod @default(ROUND_ROBIN)
  isActive          Boolean          @default(true)
  lastAssignedIndex Int              @default(-1)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  members AssignmentRuleMember[]

  @@map("assignment_rules")
}

model AssignmentRuleMember {
  id     String @id @default(cuid())
  ruleId String
  userId String
  order  Int    @default(0)

  rule AssignmentRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ruleId, userId])
  @@map("assignment_rule_members")
}

// ─────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────

enum NotificationType {
  LEAD_ASSIGNED
  FOLLOW_UP_DUE
  FOLLOW_UP_MISSED
  MENTION
  LEAD_STATUS_CHANGED
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// Audit log (system-wide, security-relevant actions)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// Public site content — admin-managed source of truth for the
// gsb-holidays marketing site (Packages/Gallery/Testimonials pages),
// pulled by that site's public read-only API.
// ─────────────────────────────────────────────────────────────

model Package {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  type         String
  // Legacy free-text destination — superseded by destinationRef below.
  // Kept temporarily as a rollback safety net; not written to by new code.
  destination    String?
  destinationId  String?
  destinationRef Destination? @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  price        Decimal  @db.Decimal(12, 2)
  priceKid     Decimal  @default(0) @db.Decimal(12, 2)
  priceInfant  Decimal  @default(0) @db.Decimal(12, 2)
  priceUnit    String   @default("per night")
  maxGuests    Int      @default(2)
  description  String
  amenities    String[] @default([])
  // Free-text notes shown as a bulleted list on the package detail page —
  // one entry per line, same shape/handling as amenities. Hidden entirely
  // on the site when empty.
  note         String[] @default([])
  // Check-in/check-out windows, one entry per line (e.g. "12:00 PM - 9:00 AM
  // (next day)") — a package can list more than one applicable time slot.
  timings      String[] @default([])
  // Meal options offered, e.g. ["Veg"], ["Non-Veg"], or both.
  mealOptions  String[] @default([])
  // On-site activities, one per line (e.g. "Cricket", "Volleyball").
  activities   String[] @default([])
  // Standout highlights shown as tags, one per line (e.g. "Lakeside Cottages").
  highlights   String[] @default([])
  // Optional extra section (title + body) rendered on the package detail
  // page below "What's included" — admin-authored, package-specific.
  extraTitle   String?
  extraContent String?
  imagePath    String
  // A YouTube/Vimeo link or direct video file URL — not stored in Tigris like
  // images, since serving large video well needs HTTP Range support the file
  // route doesn't have. gsb-holidays embeds it (iframe or <video>) as-is.
  videoUrl     String?
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images   PackageImage[]
  videos   PackageVideo[]
  leads    Lead[]
  bookings Booking[]

  @@index([isActive])
  @@index([destinationId])
  @@map("packages")
}

// CRM-managed destinations — drives the gsb-holidays site's nav "Destinations"
// dropdown and /packages?location= filtering via /api/public/destinations.
model Destination {
  id        String   @id @default(cuid())
  name      String   @unique
  // URL-safe key used by gsb-holidays' /packages?location=<slug> links —
  // derived from name at creation time and stored explicitly (not
  // recomputed on read), so it stays stable if name is later edited.
  slug      String   @unique
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packages Package[]

  @@map("destinations")
}

// Additional gallery images for a package's detail page, beyond its single
// cover image (Package.imagePath, used for card thumbnails/listings).
model PackageImage {
  id        String   @id @default(cuid())
  packageId String
  imagePath String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_images")
}

// Uploaded gallery videos for a package's detail page, alongside the single
// external videoUrl link. Stored in the same public Supabase bucket as
// images, but served via direct Supabase Storage URLs (not the app's own
// /api/public/files proxy) since that proxy buffers the whole file with no
// HTTP Range support — bad for video seeking/scrubbing.
model PackageVideo {
  id        String   @id @default(cuid())
  packageId String
  videoPath String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_videos")
}

// Singleton row (id is always "global") backing the sequential invoice
// number issued to website inquiries (see generateInvoiceNumber in
// src/lib/invoice.ts). Never resets — counts up forever across all time;
// the date embedded in the formatted invoice number is just a timestamp.
model InvoiceCounter {
  id         String   @id @default("global")
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("invoice_counters")
}

model GalleryImage {
  id        String   @id @default(cuid())
  imagePath String
  caption   String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([isActive])
  @@map("gallery_images")
}

// Standalone gallery videos (not tied to a Package) — the video counterpart
// of GalleryImage. Served via direct Supabase Storage URLs rather than the
// /api/public/files proxy, same reasoning as PackageVideo.
model GalleryVideo {
  id        String   @id @default(cuid())
  videoPath String
  caption   String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([isActive])
  @@map("gallery_videos")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  location  String
  rating    Int      @default(5)
  quote     String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("testimonials")
}

// ─────────────────────────────────────────────────────────────
// White-label branding — a single row per deployed instance.
// Each client gets their own isolated instance, so this is a
// singleton rather than per-tenant, unlike everything else here.
// ─────────────────────────────────────────────────────────────

model OrgSettings {
  id             String   @id @default("singleton")
  name           String   @default("CRM")
  logoUrl        String?
  primaryColor   String   @default("#c2410c")
  secondaryColor String   @default("#0d9488")
  supportEmail   String?
  // Independent public contact numbers shown on the gsb-holidays site —
  // separate columns so editing one can never clobber the other.
  primaryPhone   String?
  secondaryPhone String?
  updatedAt      DateTime @updatedAt

  @@map("org_settings")
}
